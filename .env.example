# Токен бота, выданный @BotFather
BOT_TOKEN=

# Telegram user_id супер-администратора (может назначать/снимать спонсоров)
SUPER_ADMIN_ID=

# ID чата (группы), в котором разрешена работа бота
ALLOWED_CHAT_ID=

# ID топика (темы) внутри чата, в котором разрешена работа бота
ALLOWED_THREAD_ID=

# Сколько дней вперёд показывать в календаре (необязательно, по умолчанию 14)
DAY_DELTA=14
